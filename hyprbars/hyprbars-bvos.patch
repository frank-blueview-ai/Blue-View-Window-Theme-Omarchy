+// ---- Button tooltips (BVOS) ----
+// Hovering a button for a moment shows what it does in a small glass label
+// below it. Drawn after windows, so it sits on top of the window's content.
+
+static constexpr double TOOLTIP_DELAY_MS = 450.0;
+static constexpr double TOOLTIP_FADE_MS  = 120.0;
+
+static void damageTooltipArea() {
+    const auto& TIP = g_pGlobalState->tooltip;
+    if (!TIP.lastBox.empty())
+        g_pHyprRenderer->damageBox(TIP.lastBox.copy().expand(2));
+    if (!TIP.anchor.empty())
+        g_pHyprRenderer->damageBox(CBox{TIP.anchor.x - 200, TIP.anchor.y, TIP.anchor.w + 400, TIP.anchor.h + 80});
+}
+
+void hideBarTooltip() {
+    auto& tip = g_pGlobalState->tooltip;
+    if (tip.owner.expired())
+        return;
+    damageTooltipArea();
+    tip.owner.reset();
+    tip.lastBox = {};
+}
+
+void CHyprBar::updateTooltip() {
+    auto&      tip   = g_pGlobalState->tooltip;
+    // Bars are uniquely owned, so compare their addresses rather than locking.
+    const bool OWNER = !tip.owner.expired() && tip.owner.get() == this;
+    const auto MOUSE = g_pInputManager->getMouseCoordsInternal();
+    const auto BAR   = assignedBoxGlobal();
+
+    int        hovered = -1;
+    CBox       anchor;
+
+    // Cheap check first: every bar hears every pointer move.
+    if (!m_hidden && validMapped(m_pWindow) && BAR.containsPoint(MOUSE) && g_layoutManager->dragController()->mode() == MBIND_INVALID) {
+        Desktop::CViewHitTester hitTester{*Desktop::viewState()};
+        const auto              WINDOWATCURSOR = hitTester.windowAt(MOUSE, Desktop::View::RESERVED_EXTENTS | Desktop::View::INPUT_EXTENTS | Desktop::View::ALLOW_FLOATING);
+
+        if (WINDOWATCURSOR == m_pWindow.lock()) {
+            const auto BARPADDING       = g_pGlobalState->config.barPadding->value();
+            const auto BARBUTTONPADDING = g_pGlobalState->config.barButtonPadding->value();
+            const auto HEIGHT           = g_pGlobalState->config.barHeight->value();
+            const bool BUTTONSRIGHT     = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+            const auto COORDS           = MOUSE - BAR.pos();
+            float      offsetLeft = BARPADDING, offsetRight = BARPADDING;
+
+            for (size_t i = 0; i < g_pGlobalState->buttons.size(); ++i) {
+                const auto& b          = g_pGlobalState->buttons[i];
+                const bool  RIGHT      = buttonOnRight(b, BUTTONSRIGHT);
+                float&      offset     = RIGHT ? offsetRight : offsetLeft;
+                Vector2D    currentPos = Vector2D{(RIGHT ? BAR.w - BARBUTTONPADDING - b.size - offset : offset), (HEIGHT - b.size) / 2.0}.floor();
+
+                if (VECINRECT(COORDS, currentPos.x, currentPos.y, currentPos.x + b.size + BARBUTTONPADDING, currentPos.y + b.size)) {
+                    hovered = i;
+                    anchor  = CBox{BAR.pos() + currentPos, Vector2D{b.size, b.size}};
+                    break;
+                }
+
+                offset += BARBUTTONPADDING + b.size;
+            }
+        }
+    }
+
+    if (hovered >= 0 && !g_pGlobalState->buttons[hovered].tooltip.empty()) {
+        const auto& TEXT = g_pGlobalState->buttons[hovered].tooltip;
+        if (!OWNER || tip.text != TEXT || tip.anchor != anchor) {
+            damageTooltipArea();
+            tip.owner   = m_self;
+            tip.text    = TEXT;
+            tip.anchor  = anchor;
+            tip.since   = Time::steadyNow();
+            tip.lastBox = {};
+            // Start frames so the delay can elapse and the label appear.
+            damageTooltipArea();
+        }
+    } else if (OWNER) {
+        hideBarTooltip();
+    }
+}
+
+void renderBarTooltip() {
+    auto&      tip     = g_pGlobalState->tooltip;
+    const auto MONITOR = g_pHyprRenderer->m_renderData.pMonitor.lock();
+    if (tip.owner.expired() || tip.text.empty() || !MONITOR || !validMapped(tip.owner.get()->getOwner()))
+        return;
+
+    const CBox MON = MONITOR->logicalBox();
+    if (!MON.containsPoint(tip.anchor.middle()))
+        return;
+
+    const double ELAPSED = std::chrono::duration<double, std::milli>(Time::steadyNow() - tip.since).count();
+    if (ELAPSED < TOOLTIP_DELAY_MS) {
+        damageTooltipArea();
+        return;
+    }
+
+    const double A     = std::clamp((ELAPSED - TOOLTIP_DELAY_MS) / TOOLTIP_FADE_MS, 0.0, 1.0);
+    const float  SCALE = MONITOR->m_scale;
+
+    if (!tip.tex || tip.texText != tip.text || tip.texScale != SCALE) {
+        const auto FONT = g_pGlobalState->config.barTextFont->value();
+        tip.tex         = g_pHyprRenderer->renderText(tip.text, CHyprColor{1.0, 1.0, 1.0, 0.92}, std::round(9 * SCALE), false, FONT, 0, 500);
+        tip.texText     = tip.text;
+        tip.texScale    = SCALE;
+    }
+    if (!tip.tex || tip.tex->m_texID == 0)
+        return;
+
+    // Below the button and clear of the pointer arrow, centered on it, kept on screen.
+    const Vector2D TEXT = tip.tex->m_size / SCALE;
+    const Vector2D PAD  = {8, 4};
+    CBox           box{tip.anchor.middle().x - (TEXT.x + PAD.x * 2) / 2.0, tip.anchor.middle().y + 22, TEXT.x + PAD.x * 2, TEXT.y + PAD.y * 2};
+    box.x = std::clamp(box.x, MON.x + 4, std::max(MON.x + 4, MON.x + MON.w - box.w - 4));
+    box.round();
+    tip.lastBox = box;
+
+    CBox local = box.copy().translate(-MONITOR->m_position).scale(SCALE).round();
+
+    // Glass like the bars: blurred, a deep navy tint and a hairline edge.
+    CRectPassElement::SRectData glass;
+    glass.box   = local;
+    glass.color = CHyprColor{0.03, 0.06, 0.12, 0.62 * A};
+    glass.round = std::round(6 * SCALE);
+    glass.blur  = true;
+    glass.blurA = A;
+    g_pHyprRenderer->m_renderPass.add(makeUnique<CRectPassElement>(glass));
+
+    const double LINE = std::max(1.0, std::round((double)SCALE));
+    const double R    = glass.round;
+    for (const CBox& b : {CBox{local.x + R, local.y, local.w - 2 * R, LINE}, CBox{local.x + R, local.y + local.h - LINE, local.w - 2 * R, LINE}}) {
+        CRectPassElement::SRectData line;
+        line.box   = b;
+        line.color = CHyprColor{1.0, 1.0, 1.0, 0.12 * A};
+        g_pHyprRenderer->m_renderPass.add(makeUnique<CRectPassElement>(line));
+    }
+
+    CTexPassElement::SRenderData text;
+    text.tex = tip.tex;
+    text.box = CBox{local.x + PAD.x * SCALE, local.y + PAD.y * SCALE, tip.tex->m_size.x, tip.tex->m_size.y}.round();
+    text.a   = A;
+    g_pHyprRenderer->m_renderPass.add(makeUnique<CTexPassElement>(std::move(text)));
+
+    if (A < 1.0)
+        damageTooltipArea();
+}
+
